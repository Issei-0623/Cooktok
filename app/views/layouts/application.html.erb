<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "CookTube" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (optional) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link href="https://fonts.googleapis.com/css2?family=RocknRoll+One&family=M+PLUS+Rounded+1c:wght@400;700&display=swap" rel="stylesheet">


    <%# Stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%# JavaScript (Importmap構成) %>
    <%= javascript_importmap_tags %>

  </head>

  <body class="<%= controller.controller_name %> <%= controller.action_name %>">
    <div id="flash">
      <%= render "layouts/flash" %>
    </div>

    <%= yield %>

  </body>
</html>
